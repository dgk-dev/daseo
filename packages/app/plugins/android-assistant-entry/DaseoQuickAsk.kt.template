package __PACKAGE__

import android.app.Activity
import android.app.Application
import android.app.KeyguardManager
import android.content.Context
import android.content.Intent
import android.net.Uri
import android.os.Bundle
import android.os.SystemClock

/**
 * Daseo delta 64: the side-button "quick ask" entry.
 *
 * Every route into quick ask ends as one URL, `paseo://quick-ask`, because React Native's
 * Linking and expo-linking only deliver VIEW intents with data. The ASSIST activity-alias is
 * rewritten here before React Native reads the intent; the voice-interaction session and the
 * static shortcut send the URL directly.
 */
object DaseoQuickAsk {
  const val URL = "paseo://quick-ask"
  /** Logcat tag for the side-button path; `phone_logs` reads it without wireless debugging. */
  const val LOG_TAG = "DaseoQuickAsk"
  /** Added when Daseo was already on screen: the app then dictates into the session in view. */
  const val FOREGROUND_URL = "$URL?from=foreground"
  private const val ASSISTANT_PROCESS_SUFFIX = ":assistant"
  // Coming back from the background starts the activity right around the new intent (Android
  // orders onStart and onNewIntent either way), so only an activity visible this long before the
  // intent counts as "already on screen".
  private const val FOREGROUND_SETTLE_MS = 1000L

  private var tracking = false
  private var startedActivities = 0
  private var visibleSince = 0L

  /** Counts visible activities of the main process; registered once, before the first onStart. */
  fun trackForeground(activity: Activity) {
    if (tracking) return
    tracking = true
    activity.application.registerActivityLifecycleCallbacks(
        object : Application.ActivityLifecycleCallbacks {
          override fun onActivityStarted(started: Activity) {
            if (startedActivities == 0) visibleSince = SystemClock.elapsedRealtime()
            startedActivities += 1
          }

          override fun onActivityStopped(stopped: Activity) {
            startedActivities = maxOf(0, startedActivities - 1)
          }

          override fun onActivityCreated(created: Activity, state: Bundle?) {}

          override fun onActivityResumed(resumed: Activity) {}

          override fun onActivityPaused(paused: Activity) {}

          override fun onActivitySaveInstanceState(saved: Activity, state: Bundle) {}

          override fun onActivityDestroyed(destroyed: Activity) {}
        },
    )
  }

  fun wasInForeground(): Boolean =
      startedActivities > 0 && SystemClock.elapsedRealtime() - visibleSince >= FOREGROUND_SETTLE_MS

  fun launchIntent(context: Context): Intent =
      Intent(Intent.ACTION_VIEW, Uri.parse(URL))
          .setClassName(context.packageName, "${context.packageName}.MainActivity")
          .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)

  /**
   * ASSIST becomes the quick-ask URL, marked when Daseo was already on screen. A quick-ask intent
   * that Android replays from Recents after the process died becomes a plain launch, so reopening
   * the task never starts another agent.
   */
  fun prepareLaunchIntent(intent: Intent?, fromForeground: Boolean) {
    if (intent == null) return
    val isQuickAskEntry = intent.action == Intent.ACTION_ASSIST || isQuickAsk(intent)
    if (!isQuickAskEntry) return
    if (intent.flags and Intent.FLAG_ACTIVITY_LAUNCHED_FROM_HISTORY != 0) {
      intent.action = Intent.ACTION_MAIN
      intent.data = null
      return
    }
    intent.action = Intent.ACTION_VIEW
    intent.data = Uri.parse(if (fromForeground) FOREGROUND_URL else URL)
  }

  fun isQuickAsk(intent: Intent?): Boolean {
    if (intent?.action != Intent.ACTION_VIEW) return false
    val data = intent.data?.toString() ?: return false
    return data == URL || data.startsWith("$URL?")
  }

  /**
   * Daseo shows private content, so it never draws over the lock screen. A quick ask that
   * arrives while the device is locked asks for the unlock (one fingerprint touch on the Fold's
   * side button) and opens once it succeeds.
   */
  fun dismissKeyguardIfLocked(activity: Activity, intent: Intent?) {
    if (!isQuickAsk(intent)) return
    val keyguard = activity.getSystemService(KeyguardManager::class.java) ?: return
    if (!keyguard.isKeyguardLocked) return
    keyguard.requestDismissKeyguard(activity, null)
  }

  /** The assistant services run in a light `:assistant` process that never loads React Native. */
  fun isAssistantProcess(): Boolean = Application.getProcessName().endsWith(ASSISTANT_PROCESS_SUFFIX)
}
